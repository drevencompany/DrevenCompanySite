# Configurações do Servidor
PORT=3000
NODE_ENV=production

# Persistência Legada em Gist
GITHUB_TOKEN=
GITHUB_GIST_ID=

# Configurações de E-mail / SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@dreven.company
SMTP_PASS=
SMTP_FROM="Dreven Company" <contato@dreven.company>
CONTACT_RECEIVER_EMAIL=contato@dreven.company

# Autenticação Administrativa (OAuth GitHub & Sessão)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
ADMIN_GITHUB_USER_ID=
SESSION_SECRET=

# Flags de Migração de Persistência
DATA_READ_BACKEND=gist
DATA_WRITE_BACKENDS=gist
